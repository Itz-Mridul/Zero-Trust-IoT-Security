# ═══════════════════════════════════════════════════════
#  Zero-Trust IoT Security Gateway — Environment Config
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to Git — it contains real secrets.
# ═══════════════════════════════════════════════════════

# ── MQTT ────────────────────────────────────────────────────────────
MQTT_BROKER=localhost
MQTT_PORT=1883

# ── Blockchain (Ganache) ─────────────────────────────────────────────
# If Ganache runs on a different machine: http://<that-machine-ip>:7545
BLOCKCHAIN_URL=http://127.0.0.1:7545
CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS_HERE

# ── Telegram Alerts ──────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Get from @userinfobot on Telegram
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# ── Raspberry Pi Network ─────────────────────────────────────────────
PI_LOCAL_IP=192.168.1.105

# ── ML Models ────────────────────────────────────────────────────────
MODEL_PATH=/home/pi/Zero-Trust-IoT-Security/ml_models/device_authenticator.h5
SCALER_PATH=/home/pi/Zero-Trust-IoT-Security/ml_models/scaler.pkl

# ── Database ─────────────────────────────────────────────────────────
DB_PATH=/home/pi/Zero-Trust-IoT-Security/security.db

# ── GPIO Pins (Raspberry Pi) ─────────────────────────────────────────
VIBRATION_PIN=17
DHT_PIN=4
POWER_RELAY_PIN=23

# ── Security Thresholds ───────────────────────────────────────────────
# ML confidence to grant access (75% = balanced, 90% = strict)
CONFIDENCE_THRESHOLD=75.0
# Ambient temp °C above which keys are wiped
TEMP_THRESHOLD=45.0
# Temperature rise rate °C/min above which keys are wiped
TEMP_RATE_PER_MIN=5.0
# Network interface for packet sniffing (wlan0 or eth0)
GATEWAY_IFACE=wlan0
